    "roughjs": "4.6.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "svelte-check": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "5.0.12",
    "vitest": "3.0.6"
  }
